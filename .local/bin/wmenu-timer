#!/usr/bin/env bash

cleanup() {
	echo "" >/tmp/timericon
	pkill -RTMIN+3 waybar
	exit 0
}

timer() {
	trap cleanup SIGHUP SIGINT SIGQUIT SIGABRT SIGTERM # 1 2 3 6 15
	while [ $TOTAL_SECONDS -gt 0 ]; do
		MIN=$(printf "%02d" $((TOTAL_SECONDS / 60)))
		SEC=$(printf "%02d" $((TOTAL_SECONDS % 60)))
		if [ -n "$TITLE" ]; then
			echo "  $TITLE $MIN:$SEC " >/tmp/timericon
		else
			echo "  $MIN:$SEC " >/tmp/timericon
		fi
		pkill -RTMIN+3 waybar
		sleep 1
		((TOTAL_SECONDS--))
	done
	if [ -n "$TITLE" ]; then
		notify-send "Timer ended: $TITLE" "Take a break"
	else
		notify-send "Timer ended" "Take a break"
	fi
	cleanup
}

menu() {
	MINUTES="$(echo "" | wmenu -f "JetBrainsMono Nerd Font 12" -p "Minutes: ")"
	[ -z "$MINUTES" ] && exit 0
	TITLE="$(echo "" | wmenu -f "JetBrainsMono Nerd Font 12" -p "Title: ")"
	TOTAL_SECONDS=$((MINUTES * 60))
	timer
}

case "$#" in
0) menu ;;
1)
	notify-send "Killing timer..." &
	kill -TERM $(pgrep -f ~/.local/bin/wmenu-timer)
	;;
esac
